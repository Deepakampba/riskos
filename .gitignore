# ---- Python bytecode ----
__pycache__/
*.pyc
*.pyo
*.pyd

# ---- Virtual envs ----
.venv/
venv/
env/

# ---- OS / Editor junk ----
.DS_Store
.vscode/
.idea/

# ---- Jupyter ----
.ipynb_checkpoints/

# ---- Env files / secrets ----
.env

# ---- Testing / tooling caches ----
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# data: ignore all, but keep curated samples
data/*
!data/.gitkeep
!data/sample_*.csv
!data/README.md
 
# ---- Build artifacts ----
build/
dist/
*.egg-info/

# ---- Outputs (generated) ----
outputs/
!outputs/.gitkeep
